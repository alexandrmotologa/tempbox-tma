{
  "name": "tempbox-tma-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Disposable email and webhook inbox Telegram Mini App and Bot with instant push notifications and 1-tap OTP code extraction.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:worker": "npm --workspace=apps/worker run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:bot": "npm --workspace=apps/bot run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
